# SupplyMind AI — Variables de Entorno (Reto Agente Platica.mx)

# API Key del Reto Agente Platica (soporta RETO_KEY, PLATICA_API_KEY, XAI_API_KEY u OPENAI_API_KEY)
RETO_KEY=
PLATICA_API_KEY=

# Endpoint Gateway Oficial de Platica (Espejo de xAI Grok)
PLATICA_BASE_URL=https://api.reto.pltk.mx/v1

# Modelo por defecto (grok-4.7)
MODEL_NAME=grok-4.7

# Directorio de casos por defecto
DATA_DIR=data/cases

# Moneda y presupuesto por defecto
DEFAULT_CURRENCY=USD
BUDGET_LIMIT_USD=5.00
