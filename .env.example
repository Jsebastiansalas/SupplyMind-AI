# SupplyMind AI - Variables de Entorno

# API Key del Reto Agente Platica (pk_...)
# Dejar vacío o con valor dummy para usar el modo de desarrollo/simulador
RETO_KEY=

# Endpoint Gateway de Platica (Espejo de xAI Grok)
PLATICA_BASE_URL=https://api.reto.pltk.mx/v1

# Modelo por defecto (grok-4.7, grok-4.6, etc.)
MODEL_NAME=grok-4.7

# Directorio de casos
DATA_DIR=data/cases

# Moneda por defecto
DEFAULT_CURRENCY=USD
